{
  "mcpServers": {
    "brave-search": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@brave/brave-search-mcp-server"],
      "env": { "BRAVE_API_KEY": "${user_config.BRAVE_API_KEY}" }
    },
    "firecrawl": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "firecrawl-mcp"],
      "env": { "FIRECRAWL_API_KEY": "${user_config.FIRECRAWL_API_KEY}" }
    },
    "reddit": {
      "type": "http",
      "url": "https://reddit-research-mcp.fastmcp.app/mcp"
    },
    "reddit-alt": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "redditapis-mcp@latest"],
      "env": { "REDDITAPIS_KEY": "${user_config.REDDITAPIS_KEY}" }
    },
    "youtube": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "youtube-data-mcp-server"],
      "env": { "YOUTUBE_API_KEY": "${user_config.YOUTUBE_API_KEY}" }
    }
  }
}
